#!/bin/bash
# 在 Live2D 项目内启动 Codex。
#
# 主 Agent 的模型/Effort 由 Codex 界面的 /model 选择；本脚本不锁定主模型。
# 子 Agent 默认固定为 gpt-6-astra / medium（Profile + Reviewer 角色双重约束）。
# Provider 由 CC Switch 当前线路决定，脚本只做识别和校验。
#
# 用法：
#   scripts/codex-live2d
#   scripts/codex-live2d official       # 可选：显式要求官方 Plus
#   scripts/codex-live2d beefapi        # 可选：显式要求 BeefAPI
#   scripts/codex-live2d exec "..."     # 其余参数透传给 codex

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
CONFIG="$CODEX_HOME/config.toml"
AUTH="$CODEX_HOME/auth.json"

usage() {
  cat <<'EOF'
用法: scripts/codex-live2d [official|beefapi] [codex 参数...]

不带线路参数时自动识别 CC Switch 当前线路。
official / beefapi 可选，用于显式校验，线路不匹配时拒绝启动。

主 Agent：在 Codex 界面用 /model 选择模型和 Effort。
子 Agent：默认 gpt-6-astra / medium。
EOF
}

expected=""
case "${1:-}" in
  official|beefapi)
    expected="$1"
    shift
    ;;
  -h|--help)
    usage
    exit 0
    ;;
esac

profile="live2d"
profile_path="$CODEX_HOME/$profile.config.toml"

if [ ! -f "$profile_path" ]; then
  echo "缺少 $profile_path。" >&2
  echo "请先运行 $ROOT/scripts/install-codex-live2d.sh" >&2
  exit 3
fi

if [ ! -f "$CONFIG" ]; then
  echo "缺少 $CONFIG；Codex 尚未初始化或 CODEX_HOME 不正确。" >&2
  exit 3
fi

current=""
if grep -q 'beefapi\.com' "$CONFIG" 2>/dev/null; then
  current="beefapi"
elif grep -q '"auth_mode"[[:space:]]*:[[:space:]]*"chatgpt"' "$AUTH" 2>/dev/null; then
  current="official"
fi

if [ -z "$current" ]; then
  echo "无法识别当前 CC Switch 线路：config.toml 不含 beefapi.com，auth.json 也不是 chatgpt 模式。" >&2
  echo "请先在 CC Switch 选择官方 Plus 或 BeefAPI。" >&2
  exit 4
fi

if [ -n "$expected" ] && [ "$current" != "$expected" ]; then
  echo "当前 CC Switch 线路是 ${current}，但请求的是 ${expected}。" >&2
  echo "请先在 CC Switch 切到对应线路，再重试。" >&2
  exit 4
fi

if [ "$current" = "beefapi" ] && ! grep -q '"OPENAI_API_KEY"' "$AUTH" 2>/dev/null; then
  echo "BeefAPI 线路需要 ~/.codex/auth.json 里的 OPENAI_API_KEY。" >&2
  echo "请用 CC Switch 重新切换或检查 BeefAPI 认证。" >&2
  exit 4
fi

echo "[codex-live2d] provider=$current reviewer=gpt-6-astra/medium; main model is chosen in Codex UI" >&2

cd "$ROOT"
exec codex -p "$profile" "$@"
